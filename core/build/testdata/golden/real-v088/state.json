  "directions": [
    {
      "tag": "auto-proxy-out",
      "type": "urltest",
      "options": {
        "interrupt_exist_connections": true,
        "interval": "5m",
        "tolerance": 100,
        "url": "https://cp.cloudflare.com/generate_204"
      },
      "filters": {
        "tag": "!/(🇷🇺)/i"
      },
      "comment": "Proxy automated group for everything that should go through VPN"
    },
    {
      "tag": "proxy-out",
      "type": "selector",
      "options": {
        "default": "auto-proxy-out",
        "interrupt_exist_connections": true
      },
      "filters": {
        "tag": "!/(🇷🇺)/i"
      },
      "addOutbounds": [
        "direct-out",
        "auto-proxy-out"
      ],
      "comment": "Proxy group for everything that should go through VPN"
    },
    {
      "tag": "ru VPN 🇷🇺",
      "type": "selector",
      "options": {
        "default": "direct-out",
        "interrupt_exist_connections": true
      },
      "filters": {
        "tag": "/(🇷🇺)/i"
      },
      "addOutbounds": [
        "direct-out"
      ],
      "comment": "Proxy group for russian VPN"
    },
    {
      "tag": "vpn ①",
      "type": "selector",
      "options": {
        "default": "proxy-out",
        "interrupt_exist_connections": true
      },
      "addOutbounds": [
        "direct-out",
        "proxy-out"
      ],
      "comment": "Proxy group 1"
    },
    {
      "tag": "vpn ②",
      "type": "selector",
      "options": {
        "default": "proxy-out",
        "interrupt_exist_connections": true
      },
      "addOutbounds": [
        "direct-out",
        "proxy-out"
      ],
      "comment": "Proxy group 2"
    }
  ],
  "rules": [
    {
      "kind": "inline",
      "enabled": false,
      "body": {
        "name": "Private IPs direct",
        "match": {
          "ip_is_private": true
        },
        "outbound": "direct-out"
      }
    },
    {
      "kind": "inline",
      "enabled": false,
      "body": {
        "name": "Local/LAN domains direct",
        "match": {
          "domain_suffix": [
            "local",
            "lan"
          ]
        },
        "outbound": "direct-out"
      }
    },
    {
      "kind": "inline",
      "enabled": true,
      "body": {
        "name": "porn",
        "match": {
          "domain_suffix": [
            "ypncdn.com",
            "adtng.com"
          ]
        },
        "outbound": "direct-out"
      }
    },
    {
      "kind": "srs",
      "enabled": false,
      "body": {
        "name": "Block Ads (ads-all, soft)",
        "srs_url": "https://raw.githubusercontent.com/runetfreedom/russia-v2ray-rules-dat/release/sing-box/rule-set-geosite/geosite-category-ads-all.srs",
        "outbound": "reject"
      }
    },
    {
      "kind": "inline",
      "enabled": true,
      "body": {
        "name": "steam | dota",
        "match": {
          "process_path_regex": [
            ".*(dota|steam|Steam).*"
          ]
        },
        "outbound": "direct-out"
      }
    },
    {
      "kind": "inline",
      "enabled": true,
      "body": {
        "name": "BitTorrent direct",
        "match": {
          "protocol": [
            "bittorrent"
          ]
        },
        "outbound": "direct-out"
      }
    },
    {
      "kind": "inline",
      "enabled": true,
      "body": {
        "name": "Russian domains direct",
        "match": {
          "rule_set": "ru-domains"
        },
        "outbound": "direct-out"
      }
    },
    {
      "kind": "inline",
      "enabled": false,
      "body": {
        "name": "Gaming ports direct",
        "match": {
          "network": [
            "tcp",
            "udp"
          ],
          "port": [
            3659,
            1935,
            5001,
            5795,
            5796,
            7000,
            7777,
            9000,
            10039,
            10040
          ],
          "port_range": "27000:27100"
        },
        "outbound": "direct-out"
      }
    },
    {
      "kind": "srs",
      "enabled": false,
      "body": {
        "name": "Games direct",
        "srs_url": "https://raw.githubusercontent.com/runetfreedom/russia-v2ray-rules-dat/release/sing-box/rule-set-geosite/geosite-category-games.srs",
        "outbound": "direct-out"
      }
    },
    {
      "kind": "srs",
      "enabled": false,
      "body": {
        "name": "Russia-only services",
        "srs_url": "https://raw.githubusercontent.com/runetfreedom/russia-v2ray-rules-dat/release/sing-box/rule-set-geosite/geosite-ru-available-only-inside.srs",
        "outbound": "direct-out"
      }
    },
    {
      "kind": "inline",
      "enabled": false,
      "body": {
        "name": "filmix",
        "match": {
          "domain_suffix": [
            "cdnsqu.com",
            "werkecdn.me"
          ]
        },
        "outbound": "vpn ②"
      }
    },
    {
      "kind": "inline",
      "enabled": false,
      "body": {
        "name": "GIT",
        "match": {
          "domain_suffix": [
            "github.com",
            "githubusercontent.com",
            "blob.core.windows.net",
            "ghcr.io",
            "storage.googleapis.com",
            "dl.google.com",
            "jitpack.io"
          ]
        },
        "outbound": "direct-out"
      }
    }
  ],
