        ],
        "server": { "type": "tls", "tag": "cloudflare_dot", "server_port": 853, "server": "@dns_ip", "detour": "@outbound" }
      },
      {
        "description": "Safe DNS (DoT)",
        "enabled": false,
        "vars": [
          { "name": "outbound", "type": "outbound", "default_value": "direct-out" },
