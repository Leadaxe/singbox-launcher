              { "title": "8.8.8.8 · Primary v4", "value": "8.8.8.8" },
              { "title": "8.8.4.4 · Secondary v4", "value": "8.8.4.4" }
            ] }
        ],
        "server": { "type": "tls", "tag": "google_dot", "server_port": 853, "server": "@dns_ip", "detour": "@outbound" }
      },
      {
