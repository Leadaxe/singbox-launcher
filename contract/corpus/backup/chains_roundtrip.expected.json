{
  "rules": [
    {
      "name": "Chained",
      "enabled": true
    }
  ],
  "warnings": [
    "backup_label_dropped"
  ],
  "directions": [
    {
      "tag": "vpn-de",
      "filter": "🇩🇪",
      "invert": false,
      "include_direct": false,
      "include_block": false,
      "has_auto": false
    }
  ],
  "chains": [
    {
      "tag": "relay",
      "chain": {
        "hops": [
          "vpn-de",
          "exit-node"
        ],
        "idle_timeout": "0s",
        "strip_evasion": false,
        "strip": {
          "tls.utls": false,
          "xhttp.padding": true
        },
        "rewrite": {
          "vless": {
            "flow": null
          }
        }
      }
    }
  ]
}
