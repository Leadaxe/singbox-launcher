# Контракт 1.1.168: пара плоскими query-параметрами (написание прото Xray sessionIDTable/sessionIDLength),
# без extra. Имя алфавита number и длина 12 едут дословно.
vless://11111111-1111-1111-1111-111111111111@example-1.com:443?type=xhttp&security=tls&sni=example-1.com&mode=packet-up&sessionIDTable=number&sessionIDLength=12#xhttp-session-flat
