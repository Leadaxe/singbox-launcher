# mport, в который панель записала АДРЕС вместе с портами: host:443,20000-30000
# Элемент «198.51.100.24:443» — не пара номеров; ядро отвечает «bad port range»
# отказом ВСЕГО конфига. item_pattern выбрасывает элемент, диапазон остаётся.
# источник: запрос LxBox 19.09.2026 (их починка 44f26d11)
hysteria2://pass123@example-1.com:443?mport=198.51.100.24%3A443%2C20000-30000&sni=example-1.com#mport-host
