# пустой host -> конструктивно невалидно, отказ
# источник: LxBox app/test/parser/uri_naive_test.dart:104-107
#
# SPEC 131 W2c: узел теперь и правда ОТБРАКОВЫВАЕТСЯ — как обещает имя кейса.
