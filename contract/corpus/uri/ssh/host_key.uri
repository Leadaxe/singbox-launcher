# SSH: host_key ("ssh-ed25519 <base64>" percent-encoded, пробел как %20) + host_key_algorithms;
# base64 ключа — синтетическая заглушка.
# Источник: LxBox app/test/fixtures/ssh/host_key.uri
ssh://testuser:testpass123@example-2.com:22?host_key=ssh-ed25519%20AAAAC3NzaC1lZDI1NTE5AAAAIExamplePlaceholderHostKeyBase64&host_key_algorithms=ssh-ed25519#SSH%20HostKey
