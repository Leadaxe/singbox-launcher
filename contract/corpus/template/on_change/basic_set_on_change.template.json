{
  "_comment": "§4.6 (D-042): при изменении var её on_change.set вычисляет #if-дерево и пишет целевую var. changed указывает, какую var поменял пользователь",
  "_changed": "flag",
  "vars": [
    {"name": "flag", "type": "bool", "default_value": "false", "on_change": {"set": {
      "@strategy": {"#if": {"and": ["@flag"], "value": "prefer_ipv4", "else": "ipv4_only"}}
    }}},
    {"name": "strategy", "type": "enum", "default_value": "ipv4_only", "options": ["ipv4_only", "prefer_ipv4"]}
  ],
  "config": {"strategy": "@strategy"}
}
