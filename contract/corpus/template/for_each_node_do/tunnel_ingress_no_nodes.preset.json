{
  "_comment": "SPEC 170, контракт 1.1.126 (без Tailscale — 1.1.129, D-136): пресет tunnel-ingress без узлов клиентских туннелей и без ввода пользователя — все пять списков пусты, каждое правило снято своим #notEmpty-условием молча: ни правил, ни template_fragment_dropped.",
  "preset": {
    "for_each_node_do": {
      "#filter": {
        "@node.body.type": {
          "#in": [
            "wireguard",
            "openvpn-client",
            "openconnect"
          ]
        }
      },
      "#do": {
        "@all_nodes": {
          "#append": "@node"
        },
        "@allow_local_nodes": {
          "#if": [
            "@node.allow_local",
            {
              "#append": "@node"
            }
          ]
        },
        "@allow_lan_nodes": {
          "#if": [
            "@node.allow_lan",
            {
              "#append": "@node"
            }
          ]
        },
        "@allow_gateway_nodes": {
          "#if": [
            "@node.allow_gateway",
            {
              "#append": "@node"
            }
          ]
        },
        "@closed_nodes": {
          "#if": [
            {
              "#not": "@node.allow_gateway"
            },
            {
              "#append": "@node"
            }
          ]
        }
      }
    },
    "vars": [
      {
        "name": "all_nodes",
        "type": "text_list",
        "unique": true,
        "title": "Tunnel endpoints",
        "tooltip": "Every client tunnel endpoint in the config. Anything from them not allowed below is rejected."
      },
      {
        "name": "allow_local_nodes",
        "type": "text_list",
        "unique": true,
        "title": "May reach this device",
        "tooltip": "Peers of these endpoints reach services on this device's tunnel address. The service sees them as 127.0.0.1."
      },
      {
        "name": "allow_lan_nodes",
        "type": "text_list",
        "unique": true,
        "title": "May reach the local network",
        "tooltip": "Peers of these endpoints reach private networks behind this device."
      },
      {
        "name": "allow_gateway_nodes",
        "type": "text_list",
        "unique": true,
        "title": "May use this device as a gateway",
        "tooltip": "Peers of these endpoints route everything else through the outbound chosen below."
      },
      {
        "name": "closed_nodes",
        "type": "text_list",
        "wizard_ui": "internal"
      },
      {
        "name": "gateway_out",
        "type": "outbound",
        "default_value": "proxy-out",
        "title": "Gateway traffic goes to",
        "tooltip": "Outbound for peers allowed to use this device as a gateway."
      }
    ],
    "rules": [
      {
        "#if": [
          {
            "@allow_local_nodes": "#notEmpty"
          },
          {
            "inbound": "@allow_local_nodes",
            "ip_cidr": [
              "127.0.0.0/8",
              "::1/128"
            ],
            "outbound": "direct-out"
          }
        ]
      },
      {
        "#if": [
          {
            "@allow_lan_nodes": "#notEmpty"
          },
          {
            "inbound": "@allow_lan_nodes",
            "ip_is_private": true,
            "outbound": "direct-out"
          }
        ]
      },
      {
        "#if": [
          {
            "@allow_gateway_nodes": "#notEmpty"
          },
          {
            "inbound": "@allow_gateway_nodes",
            "outbound": "@gateway_out"
          }
        ]
      },
      {
        "#if": [
          {
            "@all_nodes": "#notEmpty"
          },
          {
            "inbound": "@all_nodes",
            "action": "reject"
          }
        ]
      }
    ],
    "dns_rules": [
      {
        "#if": [
          {
            "@closed_nodes": "#notEmpty"
          },
          {
            "inbound": "@closed_nodes",
            "action": "reject"
          }
        ]
      }
    ]
  },
  "nodes": [
    {
      "tag": "v1",
      "body": {
        "type": "vless",
        "tag": "v1",
        "server": "v1.example",
        "server_port": 443
      }
    }
  ]
}
