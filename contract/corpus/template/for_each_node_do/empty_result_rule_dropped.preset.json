{
  "_comment": "Ни один узел не прошёл #filter, ввода пользователя нет: итог пуст, DNS-правило осталось без условий — сбой, правило снимается с template_fragment_dropped (§5.1, §6.7.3), а не перехватывает все запросы.",
  "preset": {
    "for_each_node_do": {
      "#filter": {
        "#and": [
          {
            "@node.body.server": "#notEmpty"
          },
          {
            "#not": {
              "@node.body.server": {
                "#matches": "^[0-9.]+$"
              }
            }
          },
          {
            "#not": {
              "@node.body.server": {
                "#matches": ":"
              }
            }
          }
        ]
      },
      "#do": {
        "@domains": {
          "#append": "@node.body.server"
        }
      }
    },
    "vars": [
      {
        "name": "domains",
        "type": "text_list"
      }
    ],
    "dns_rules": [
      {
        "domain": "@domains",
        "server": "dns-x"
      }
    ]
  },
  "nodes": [
    {
      "tag": "b",
      "body": {
        "type": "vless",
        "tag": "b",
        "server": "1.2.3.4",
        "server_port": 443
      }
    },
    {
      "tag": "home-ts",
      "body": {
        "type": "tailscale",
        "tag": "home-ts",
        "hostname": "home-ts-host"
      }
    }
  ]
}
