{
  "_comment": "D-133 (§6.7.1): та же операция в длинной форме — expected равен do_if_true_appends.",
  "preset": {
    "for_each_node_do": {
      "#do": {
        "@list": {
          "#if": {
            "#and": [
              {
                "@node.body.type": "tailscale"
              }
            ],
            "#value": {
              "#append": "@node"
            }
          }
        }
      }
    },
    "vars": [
      {
        "name": "list",
        "type": "text_list"
      }
    ],
    "rules": [
      {
        "domain": "@list",
        "outbound": "direct-out"
      }
    ]
  },
  "nodes": [
    {
      "tag": "a",
      "body": {
        "type": "vless",
        "tag": "a",
        "server": "a.example",
        "server_port": 443
      }
    },
    {
      "tag": "home-ts",
      "skip_tailscale_presets": true,
      "body": {
        "type": "tailscale",
        "tag": "home-ts",
        "hostname": "home-ts-host"
      }
    },
    {
      "tag": "e",
      "body": {
        "type": "vless",
        "tag": "e",
        "server": "b.example",
        "server_port": 443
      }
    }
  ]
}
