{
  "_comment": "Переменная пресета dns_enable=false: DNS-сервер, DNS-правило и правило resolve уходят, правило маршрута остаётся.",
  "preset": {
    "for_each": {
      "node_type": "tailscale",
      "as": "node",
      "filter": {
        "#not": "@node.skip_presets"
      }
    },
    "vars": [
      {
        "name": "dns_enable",
        "type": "bool",
        "default_value": "true"
      }
    ],
    "rules": [
      {
        "#if": {
          "#and": [
            "@dns_enable"
          ],
          "#value": {
            "preferred_by": [
              "@node"
            ],
            "action": "resolve",
            "server": {
              "#tpl": "@{node}-dns"
            }
          }
        }
      },
      {
        "preferred_by": [
          "@node"
        ],
        "outbound": "@node"
      }
    ],
    "dns_servers": [
      {
        "#if": {
          "#and": [
            "@dns_enable"
          ],
          "#value": {
            "type": "tailscale",
            "tag": {
              "#tpl": "@{node}-dns"
            },
            "endpoint": "@node",
            "description": "MagicDNS of the tailnet"
          }
        }
      }
    ],
    "dns_rules": [
      {
        "#if": {
          "#and": [
            "@dns_enable"
          ],
          "#value": {
            "preferred_by": [
              {
                "#tpl": "@{node}-dns"
              }
            ],
            "server": {
              "#tpl": "@{node}-dns"
            }
          }
        }
      }
    ]
  },
  "nodes": [
    {
      "tag": "home-ts",
      "body": {
        "type": "tailscale",
        "tag": "home-ts",
        "hostname": "home-ts-host"
      }
    }
  ]
}
