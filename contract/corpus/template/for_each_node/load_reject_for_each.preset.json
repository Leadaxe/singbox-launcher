{
  "_comment": "Снятый ключ for_each (контракт 1.1.119, D-130) — ошибка загрузки, легаси-чтения нет.",
  "preset": {
    "for_each": {
      "node_type": "tailscale",
      "as": "node"
    },
    "rules": [
      {
        "preferred_by": [
          "@node"
        ],
        "outbound": "@node"
      }
    ]
  },
  "nodes": [
    {
      "tag": "home-ts",
      "body": {
        "type": "tailscale",
        "tag": "home-ts",
        "hostname": "home-ts-host"
      }
    }
  ]
}
