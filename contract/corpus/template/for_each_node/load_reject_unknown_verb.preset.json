{
  "_comment": "Глагол операции #do вне закрытого списка (#set) — ошибка загрузки.",
  "preset": {
    "for_each_node_do": {
      "#do": {
        "@domains": {
          "#set": "@node.body.server"
        }
      }
    },
    "vars": [
      {
        "name": "domains",
        "type": "text_list"
      }
    ],
    "dns_rules": [
      {
        "domain": "@domains",
        "server": "dns-x"
      }
    ]
  },
  "nodes": [
    {
      "tag": "a",
      "body": {
        "type": "vless",
        "tag": "a",
        "server": "a.example",
        "server_port": 443
      }
    }
  ]
}
