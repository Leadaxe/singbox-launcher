{
  "_comment": "Поле тела — пустая строка: пустое значение, #tpl снимается целиком (ключ исчезает).",
  "preset": {
    "for_each_node": {
      "#filter": {
        "@node.body.type": "tailscale"
      }
    },
    "rules": [
      {
        "domain": [
          "x.example"
        ],
        "outbound": "@node",
        "comment": {
          "#tpl": "@{node.body.control_url}-x"
        }
      }
    ]
  },
  "nodes": [
    {
      "tag": "home-ts",
      "body": {
        "type": "tailscale",
        "tag": "home-ts",
        "control_url": ""
      }
    }
  ]
}
