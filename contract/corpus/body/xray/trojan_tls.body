[{"remarks": "trojan", "outbounds": [{"tag": "proxy", "protocol": "trojan", "settings": {"servers": [{"address": "t.example", "port": 443, "password": "secret"}]}, "streamSettings": {"network": "tcp", "security": "tls", "tlsSettings": {"serverName": "t.example", "fingerprint": "firefox"}}}]}]
