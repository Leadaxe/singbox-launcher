# Вход Xray из набора LxBox (app/test/fixtures/xray/pipeline_identity_before.json,
# кейс hysteria2_fp_junk). Снят ДО перевода xray-входа на движок: сверка по бедным входам
# зелёная и при потере полей — у LxBox так ушло ~25 полей XHTTP.
[{"remarks": "hy2 fp", "outbounds": [{"tag": "proxy", "protocol": "hysteria", "settings": {"address": "hy.example", "port": 8443}, "streamSettings": {"security": "tls", "tlsSettings": {"serverName": "hy.example", "fingerprint": "bogus"}, "hysteriaSettings": {"version": 2, "auth": "pw"}}}]}]
