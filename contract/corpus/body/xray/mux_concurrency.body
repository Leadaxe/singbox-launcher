# Xray-элемент с включённым mux. С 1.1.169 (D-146) mux в тело НЕ ЕДЕТ: Xray mux —
# протокол Mux.Cool (служебный адрес v1.mux.cool), а multiplex ядра —
# h2mux/smux/yamux (sp.mux.sing-box.arpa). Сервер Xray адрес sing-box принимает
# за обычное назначение, и узел с multiplex не соединялся вовсе (LxBox 727).
# Узел едет без мультиплексирования, истинный enabled даёт код
# xray_mux_unsupported. concurrency/xudpConcurrency/xudpProxyUDP443 — объявленное
# чтение без записи, json_field_unknown они не дают.
[{"remarks":"mux","outbounds":[{"tag":"proxy","protocol":"vless","settings":{"vnext":[{"address":"a.example","port":443,"users":[{"id":"11111111-2222-3333-4444-555555555555","encryption":"none"}]}]},"streamSettings":{"network":"tcp","security":"none"},"mux":{"enabled":true,"concurrency":8,"xudpConcurrency":16,"xudpProxyUDP443":"reject"}}]}]
