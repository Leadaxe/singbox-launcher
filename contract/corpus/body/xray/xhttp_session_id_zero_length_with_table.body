# Контракт 1.1.168: `sessionIDLength: 0` при заданной таблице — нулевая длина = «не задано» (не пишется),
# оставшаяся одна таблица снимается парной защитой тела (field_requires). У Xray такая пара — ошибка конфига.
[{"remarks":"xhttp session zero length","outbounds":[{"tag":"proxy","protocol":"vless","settings":{"vnext":[{"address":"example-1.com","port":443,"users":[{"id":"11111111-1111-1111-1111-111111111111","encryption":"none"}]}]},"streamSettings":{"network":"xhttp","security":"none","xhttpSettings":{"path":"/p","mode":"packet-up","extra":{"sessionIDTable":"hex","sessionIDLength":0}}}}]}]
