# Контракт 1.1.168: `sessionIDTable`/`sessionIDLength` ПЛОСКО в xhttpSettings (без extra).
# Литеральный алфавит едет дословно, длина ДИАПАЗОНОМ "10-20" — строкой как есть.
[{"remarks":"xhttp session table flat","outbounds":[{"tag":"proxy","protocol":"vless","settings":{"vnext":[{"address":"example-1.com","port":443,"users":[{"id":"11111111-1111-1111-1111-111111111111","encryption":"none"}]}]},"streamSettings":{"network":"xhttp","security":"none","xhttpSettings":{"path":"/p","mode":"stream-up","sessionIDTable":"abcdefghijklmnopqrstuvwxyz0123456789","sessionIDLength":"10-20"}}}]}]
