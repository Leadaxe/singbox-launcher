# Xray: фрагментация ClientHello второй формой — маскировщик в самом узле,
# streamSettings.finalmask.tcp[] с элементом type=fragment (контракт 1.1.83,
# LxBox §573). Смысл тот же, что у dialerProxy на freedom с fragment:
# tls.fragment узлу с TLS. Элемент ищет селектор tcp[type=fragment]
# (запись fragment_via_finalmask, dialer.json); packets/length/delay/maxSplit
# не переносятся и кода не дают. vless + xhttp + reality — форма живого входа.
[{"remarks":"fm-frag","outbounds":[{"tag":"proxy","protocol":"vless","settings":{"vnext":[{"address":"example-1.com","port":443,"users":[{"id":"11111111-1111-1111-1111-111111111111","encryption":"none"}]}]},"streamSettings":{"network":"xhttp","xhttpSettings":{"path":"/x","mode":"auto"},"security":"reality","realitySettings":{"serverName":"example-2.com","publicKey":"mnL3vXjnwysMjlryreyJyrXZ5eaEuhDTpCD3r7UoBBU","shortId":"d48964df7db5","fingerprint":"chrome"},"finalmask":{"tcp":[{"type":"fragment","settings":{"packets":"tlshello","length":"20-40","delay":"3-10","maxSplit":"3-6"}}]}}}]}]
