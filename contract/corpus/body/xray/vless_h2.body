# Вход Xray из набора LxBox (app/test/fixtures/xray/pipeline_identity_before.json,
# кейс vless_h2). Снят ДО перевода xray-входа на движок: сверка по бедным входам
# зелёная и при потере полей — у LxBox так ушло ~25 полей XHTTP.
[{"remarks": "h2", "outbounds": [{"tag": "proxy", "protocol": "vless", "settings": {"vnext": [{"address": "h.example", "port": 443, "users": [{"id": "11111111-2222-3333-4444-555555555555"}]}]}, "streamSettings": {"network": "h2", "security": "tls", "tlsSettings": {"serverName": "s.example"}, "httpSettings": {"path": "/h2", "host": ["a.example", "b.example"]}}}]}]
