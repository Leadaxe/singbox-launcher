# Вход Xray из набора LxBox (app/test/fixtures/xray/pipeline_identity_before.json,
# кейс balancer_group). Снят ДО перевода xray-входа на движок: сверка по бедным входам
# зелёная и при потере полей — у LxBox так ушло ~25 полей XHTTP.
[{"remarks": "bal", "outbounds": [{"tag": "proxy", "protocol": "vless", "settings": {"vnext": [{"address": "a.example", "port": 443, "users": [{"id": "11111111-2222-3333-4444-555555555555"}]}]}, "streamSettings": {"network": "tcp", "security": "none"}}], "routing": {"balancers": [{"tag": "bal", "selector": ["proxy"], "strategy": {"type": "leastPing"}}]}, "burstObservatory": {"pingConfig": {"destination": "http://example.com", "interval": "30s"}}}]
