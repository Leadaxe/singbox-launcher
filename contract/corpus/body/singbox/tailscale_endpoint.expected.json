{
  "meta": {
    "body_kind": "singbox-config"
  },
  "nodes": [
    {
      "entry": {
        "accept_routes": true,
        "exit_node": "exit-1",
        "type": "tailscale"
      },
      "kind": "endpoint",
      "label": "ts-home",
      "scheme": "tailscale",
      "sections": {
        "dns": {
          "rules": [
            {
              "body": {
                "domain_suffix": [
                  ".ts.net"
                ],
                "server": "@{self}-dns"
              },
              "enabled": true,
              "kind": "user"
            }
          ],
          "servers": [
            {
              "body": {
                "endpoint": "@self",
                "type": "tailscale"
              },
              "enabled": true,
              "kind": "user",
              "tag": "@{self}-dns"
            }
          ]
        },
        "rules": [
          {
            "body": {
              "outbound": "@self",
              "preferred_by": [
                "@self"
              ]
            },
            "enabled": true,
            "kind": "inline",
            "name": "@{self} tailscale route"
          }
        ]
      }
    }
  ],
  "v": 1
}
