# «tls: {enabled: false}» = TLS НЕ ЗАДАН — правило реестра `absent_when`
# (контракт 1.1.12), а не код парсера. Прежде оно жило рукописной копией в
# импорте sing-box и потому работало ТОЛЬКО на этом входе: то же тело, попавшее
# в лаунчер ручным JSON вкладки или чужим бэкапом, доезжало до config.json с
# выключенным блоком (SPEC 045: такой блок ронял ядра 1.14.0-lx.5..lx.18
# SIGSEGV'ом на первом dial, потому что конструктор TLS отдаёт (nil, nil), а
# dialer всё равно строится по НАЛИЧИЮ блока).
#
# Нормативен здесь не только исчезнувший блок, но и ПОРЯДОК: объект снимается
# ДО правил своих полей и ДО связей соседей. Поэтому мусор внутри выключенного
# блока кодов НЕ даёт — судить поля объекта, которого в теле не будет, значит
# показывать человеку ⚠ за настройку, которой нет.
#
#   - tls-off-with-junk: выключенный tls с негодным pbk, запрещённым naive
#     полем и ключом вне схемы внутри → блока нет, кодов нет;
#   - tls-off-string: тот же выключатель, записанный СТРОКОЙ — тело приезжает
#     и от маппера, где булев флаг бывает строкой;
#   - reality-off-in-live-tls: выключен только reality → снят только он, сам
#     tls и соседний utls целы;
#   - utls-off-in-live-tls: тем же атрибутом, а не особым случаем;
#   - ech-off-not-conflicting: выключенный ech НЕ конфликтует с живым REALITY
#     (без нормы порядка reality получил бы field_conflict с блоком, которого
#     в теле не будет);
#   - tls-on-same-junk: КОНТРОЛЬ. Тот же негодный pbk в ЖИВОМ tls код получает
#     (reality_pbk_invalid) и блок reality теряет — иначе первый кейс доказывал
#     бы лишь то, что правила молчат вообще.
[
  {"type":"vless","tag":"tls-off-with-junk","server":"off-1.example.com","server_port":443,"uuid":"11111111-1111-1111-1111-111111111111","tls":{"enabled":false,"server_name":"off-1.example.com","insecure":true,"totally_unknown_key":"whatever","reality":{"enabled":true,"public_key":"junk"}}},
  {"type":"vless","tag":"tls-off-string","server":"off-2.example.com","server_port":443,"uuid":"22222222-2222-2222-2222-222222222222","tls":{"enabled":"false","server_name":"off-2.example.com"}},
  {"type":"vless","tag":"reality-off-in-live-tls","server":"off-3.example.com","server_port":443,"uuid":"33333333-3333-3333-3333-333333333333","tls":{"enabled":true,"server_name":"off-3.example.com","utls":{"enabled":true,"fingerprint":"chrome"},"reality":{"enabled":false,"public_key":"junk","short_id":"zz"}}},
  {"type":"vless","tag":"utls-off-in-live-tls","server":"off-4.example.com","server_port":443,"uuid":"44444444-4444-4444-4444-444444444444","tls":{"enabled":true,"server_name":"off-4.example.com","utls":{"enabled":false,"fingerprint":"chrome"}}},
  {"type":"vless","tag":"ech-off-not-conflicting","server":"off-5.example.com","server_port":443,"uuid":"55555555-5555-5555-5555-555555555555","tls":{"enabled":true,"server_name":"off-5.example.com","ech":{"enabled":false},"utls":{"enabled":true,"fingerprint":"chrome"},"reality":{"enabled":true,"public_key":"AwoRGB8mLTQ7QklQV15lbHN6gYiPlp2kq7K5wMfO1dw","short_id":"abcd"}}},
  {"type":"vless","tag":"tls-on-same-junk","server":"off-6.example.com","server_port":443,"uuid":"66666666-6666-6666-6666-666666666666","tls":{"enabled":true,"server_name":"off-6.example.com","utls":{"enabled":true,"fingerprint":"chrome"},"reality":{"enabled":true,"public_key":"junk"}}}
]
