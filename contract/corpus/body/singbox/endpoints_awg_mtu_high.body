# AWG-endpoint в sing-box JSON ПОДПИСКИ с mtu=1420: узел подписки авторским
# не бывает и получает вход `other` (контракт 1.1.87, PARSING_PRINCIPLES
# §10.4), поэтому исключение по входу (`except_sources: singbox`) не
# действует — значение заменяется на 1280 с кодом awg_mtu_clamped, как у
# ссылки (uri/wireguard/awg_mtu_1420_clamped). До 1.1.87 здесь стоял
# awg_mtu_high. Авторское тело своего узла сохраняет 1420 —
# authored/soft_awg_mtu_high_kept.
{"endpoints":[{"type":"wireguard","tag":"awg-ep","mtu":1420,"address":["10.0.0.2/32"],"private_key":"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaA=","jc":10,"peers":[{"address":"example-3.com","port":51820,"public_key":"bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbA=","allowed_ips":["0.0.0.0/0"]}]}]}
