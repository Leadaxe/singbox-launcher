# SPEC 131 §9 критерий 2: JSON-половина пары к uri/vless/junk_pair_with_body.uri.
# Тот же узел, тот же мусор — тело и коды обязаны совпасть с ссылочной
# половиной. Расхождение здесь означает, что маппер ссылки и маппер JSON
# приняли РАЗНЫЕ решения о значениях, то есть конвейер снова раздвоился.
#
# СОСТОЯНИЕ НА W2c: ТЕЛА двух половин совпадают байт в байт — это и есть
# проверяемый критерий. Наборы КОДОВ пока отличаются путями: правила значений
# всё ещё живут в URI-парсерах (вынос в реестр — волна W2d), парсер снимает
# поле сам и ставит код БЕЗ пути, а санитайзер снятого поля уже не видит.
# У JSON-половины тот же код приходит от санитайзера и путь несёт. После W2d
# обе половины обязаны дать один набор с одинаковыми путями, и этот кейс —
# то место, где это будет видно.
{"type":"vless","tag":"junk-pair","server":"pair.example-1.com","server_port":443,"uuid":"11111111-1111-1111-1111-111111111111","flow":"xtls-rprx-direct","packet_encoding":"teleport","tls":{"enabled":true,"server_name":"cover.example-1.com","utls":{"enabled":true,"fingerprint":"chrome"},"reality":{"enabled":true,"public_key":"AwoRGB8mLTQ7QklQV15lbHN6gYiPlp2kq7K5wMfO1dw","short_id":"abc"}}}
