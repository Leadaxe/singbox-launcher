# sing-box: hysteria v1 с obfs-объектом БЕЗ пароля. Разворачивать нечего:
# obfs снят с кодом obfs_password_missing (else_code правила unwrap), узел
# подключается без обфускации. Параметр {type} кода — член type объекта
# (SPEC 142 C1, контракт 1.1.57). meta.extension=desktop — см. соседний кейс.
{"type": "hysteria", "tag": "hy1-obfs-nopass", "server": "example-1.com", "server_port": 443, "auth_str": "testpass123", "up_mbps": 50, "down_mbps": 100, "obfs": {"type": "salamander"}, "tls": {"enabled": true, "server_name": "example-1.com"}}
