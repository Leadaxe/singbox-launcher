# sing-box: НЕстроковые элементы в строковых списках — tls.alpn [443, "h2"] и
# server_ports [443]. Ядро такой список не разберёт и откажет всему конфигу,
# поэтому в тело узла он доехать не вправе. Узел живёт.
#
# НОРМА ПЕРЕСМОТРЕНА, контракт 1.1.50 (решение владельца 24.09.2026,
# согласовано с LxBox §510 M1): негодный элемент снимается ЭЛЕМЕНТОМ, а не
# роняет поле целиком. Прежнее ожидание (1.1.49) снимало весь список кодом
# type_invalid — и человек оставался без ALPN вовсе, хотя «h2» рядом был годен;
# цена ошибки провайдера ложилась на него целиком. Теперь путь кода — ЭЛЕМЕНТ
# (alpn[0], server_ports[0]), код берётся из on_item_invalid поля, и это ровно
# та же норма, что у item_pattern с 1.1.40: два правила об одном («ядру такой
# элемент не годится») обязаны вести себя одинаково.
#
# server_ports здесь остаётся БЕЗ поля: годных элементов у него не осталось
# ни одного, а пустой остаток = отсутствие значения, а не type_invalid —
# причину уже назвал код на элементе.
# источник: ревью реестра LxBox (TASKS_LXBOX §45.5), пересмотр — §46
[
  {
    "type": "hysteria2",
    "tag": "hy2-mixed",
    "server": "example-2.com",
    "server_port": 8443,
    "server_ports": [443],
    "password": "testpass123",
    "tls": {
      "enabled": true,
      "server_name": "example-2.com",
      "alpn": [443, "h2"]
    }
  }
]
