# sing-box: hysteria v1 с obfs ОБЪЕКТОМ {type, password} — формой hysteria2.
# У v1 obfs — плоская строка-секрет; ядро на объекте отвергает ВЕСЬ конфиг.
# Реестр (hysteria.body.obfs, on_invalid unwrap key=password) берёт password
# строкой, код obfs_object_flattened (info); значение секрета маскируется.
# Прежде это делала рукописная копия только на импорте sing-box и молча;
# ручной JSON и бэкап теряли obfs с type_invalid (SPEC 142 C1, контракт 1.1.57).
# У LxBox парсера hysteria v1 нет — кейс помечен meta.extension=desktop.
{"type": "hysteria", "tag": "hy1-obfs-object", "server": "example-1.com", "server_port": 443, "auth_str": "testpass123", "up_mbps": 50, "down_mbps": 100, "obfs": {"type": "salamander", "password": "testobfs123"}, "tls": {"enabled": true, "server_name": "example-1.com"}}
