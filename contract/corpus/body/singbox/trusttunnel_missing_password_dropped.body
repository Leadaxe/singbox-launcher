# sing-box: trusttunnel без password (контракт 1.1.141). Ядро отвергает запись
# («missing password», NewOutbound) и не запускает весь конфиг; поле обязательно
# с core_rejects — узел снимается с кодом field_missing. То же для username и
# tls (C.ErrTLSRequired).
{"outbounds":[{"type":"trusttunnel","tag":"tt-nopass","server":"tt.example.com","server_port":443,"username":"user","tls":{"enabled":true,"server_name":"tt.example.com"}}]}
