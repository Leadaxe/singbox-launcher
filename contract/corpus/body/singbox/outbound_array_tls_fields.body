# sing-box: массив outbound'ов с полными TLS-полями (LxBox #140).
# Эмиттер — allowlist по OutboundTLSOptions ядра: всё, что ядро знает
# (certificate, alpn, min/max_version, пины, client_*, fragment…), обязано
# пережить разбор → эмиссию. Раньше выживали только enabled/server_name/
# alpn([]string)/utls/insecure/pins/reality, а certificate у naive терялся.
# kernel_tx/kernel_rx в корпусе нет намеренно: ядро принимает их только на
# Linux, эмиттер гейтит по runtime.GOOS — ожидание было бы платформозависимым.
[
  {"type":"naive","tag":"naive-cert","server":"1.2.3.4","server_port":443,"username":"user","password":"password","tls":{"enabled":true,"server_name":"server.com","certificate":"-----BEGIN CERTIFICATE-----\nMIIBzzCCAXWgAwIBAgIUc=\n-----END CERTIFICATE-----\n"}},
  {"type":"trojan","tag":"trojan-full-tls","server":"example-2.com","server_port":443,"password":"pw","tls":{"enabled":true,"disable_sni":false,"server_name":"example-2.com","insecure":false,"alpn":["h2","http/1.1"],"min_version":"1.2","max_version":"1.3","cipher_suites":["TLS_AES_128_GCM_SHA256"],"curve_preferences":["X25519"],"certificate":["-----BEGIN CERTIFICATE-----\nAAAA\n-----END CERTIFICATE-----\n"],"certificate_path":"/etc/ssl/ca.pem","certificate_public_key_sha256":["MTIzNDU2Nzg5MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTI="],"client_certificate":"-----BEGIN CERTIFICATE-----\nBBBB\n-----END CERTIFICATE-----\n","client_certificate_path":"/etc/ssl/client.pem","client_key":"-----BEGIN PRIVATE KEY-----\nCCCC\n-----END PRIVATE KEY-----\n","client_key_path":"/etc/ssl/client.key","fragment":true,"fragment_fallback_delay":"500ms","record_fragment":true,"utls":{"enabled":true,"fingerprint":"chrome"}}},
  {"type":"vless","tag":"vless-alpn-str","server":"example-3.com","server_port":443,"uuid":"11111111-1111-1111-1111-111111111111","tls":{"enabled":true,"server_name":"example-3.com","alpn":"h3","disable_sni":true}}
]
