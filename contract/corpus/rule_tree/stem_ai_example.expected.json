{
  "rule_set": [
    {
      "tag": "Ai:geosite-category-ai-!cn",
      "type": "local",
      "format": "binary"
    },
    {
      "tag": "Ai:geosite-google",
      "type": "local",
      "format": "binary"
    },
    {
      "tag": "Ai",
      "type": "inline",
      "rules": [
        {
          "domain_suffix": [
            "openai.com",
            "anthropic.com"
