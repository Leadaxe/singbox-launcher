# Авторское тело (свой сервер, источник — голое тело узла): элемент hysteria2.server_ports не пара портов.
# Ядро sing-box-lx отвергает такой конфиг целиком (sing-quic hysteria2.NewClient → hysteria.ParsePorts: «bad port range»), поэтому правило
# жёсткое (core_rejects, контракт 1.1.91) и применяется и на авторском теле:
# код без applied:false.
{"type":"hysteria2","tag":"own-hy2","server":"example-5.com","server_port":443,"password":"testpass123","server_ports":["198.51.100.24:443","20000:30000"],"tls":{"enabled":true,"server_name":"example-5.com"}}
