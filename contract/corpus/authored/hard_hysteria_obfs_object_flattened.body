# Авторское тело (свой сервер, источник — голое тело узла): hysteria (v1) obfs объектом, а не строкой.
# Ядро sing-box-lx отвергает такой конфиг целиком (разбор option.HysteriaOutboundOptions: obfs — строка), поэтому правило
# жёсткое (core_rejects, контракт 1.1.91) и применяется и на авторском теле:
# код без applied:false.
{"type":"hysteria","tag":"own-hy","server":"example-5.com","server_port":443,"up_mbps":10,"down_mbps":50,"obfs":{"type":"salamander","password":"testpass123"},"tls":{"enabled":true,"server_name":"example-5.com"}}
