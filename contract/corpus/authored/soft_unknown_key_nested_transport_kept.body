# Авторское тело (свой сервер, источник — голое тело узла): лишний ключ во
# вложенном объекте транспорта — мягкое правило. Код unknown_key появляется
# при РАЗБОРЕ (санитайзер прогоняется по телу, берутся только
# предупреждения), поле остаётся, код с applied:false (контракт 1.1.88,
# LxBox §577 раздел 6).
{"type":"vless","tag":"own-vless-ws","server":"example-6.com","server_port":443,"uuid":"00000000-0000-4000-8000-000000000583","tls":{"enabled":true,"server_name":"example-6.com"},"transport":{"type":"ws","path":"/ws","baz":true}}
