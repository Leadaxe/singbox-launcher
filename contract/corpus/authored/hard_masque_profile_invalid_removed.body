# Авторское тело (свой сервер, источник — голое тело узла): masque.profile вне набора.
# Ядро sing-box-lx отвергает такой конфиг целиком (protocol/masque/outbound.go NewOutbound → masque.ParseProfile), поэтому правило
# жёсткое (core_rejects, контракт 1.1.91) и применяется и на авторском теле:
# код без applied:false.
{"type":"masque","tag":"own-masque","server":"example-5.com","server_port":443,"profile":"bogus","uri":"https://example-5.com/.well-known/masque/ip/*/*/"}
