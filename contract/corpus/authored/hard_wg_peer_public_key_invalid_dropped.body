# Авторское тело (свой сервер, источник — голое тело узла): peers[].public_key не base64.
# Ядро sing-box-lx отвергает такой конфиг целиком (transport/wireguard/endpoint.go NewEndpoint: «decode public key for peer»), поэтому правило
# жёсткое (core_rejects, контракт 1.1.91) и применяется и на авторском теле:
# код без applied:false.
{"type":"wireguard","tag":"own-wg","address":["10.0.0.2/32"],"private_key":"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaA=","peers":[{"address":"example-3.com","port":51820,"public_key":"not*base64","allowed_ips":["0.0.0.0/0"]}]}
