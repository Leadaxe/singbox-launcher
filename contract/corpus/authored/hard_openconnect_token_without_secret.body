# Авторское тело openconnect: token с mode, но без secret и secret_path
# (контракт 1.1.122). Правило required у token.secret помечено core_rejects:
# ядро отвергает такой token и не запускает весь конфиг, поэтому правило
# ЖЁСТКОЕ и применяется к авторскому телу — token снят, узел жив.
{"type":"openconnect","tag":"own-forti","server":"fw.example.com","flavor":"fortinet","username":"user","token":{"mode":"totp"}}
