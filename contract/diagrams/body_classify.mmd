%% Нормативная классификация тела подписки (SPEC 103, PLAN §4).
%% Расхождения текущих реализаций: B4 (Go режет одиночный JSON-объект на fetch-пути),
%% B5 (Go: нет Clash-подсказки), B11 (Go: нет INI-ветки) — целевое состояние ниже.
flowchart TD
  A["Тело подписки (после fetch)"] --> T["trim + UTF-8-проверка"]
  T --> V{"начинается с vpn:// ?"}
  V -- да --> AM["Amnezia-контейнер:
base64url + qCompress/zlib
анти-bomb cap 4 MiB
→ контейнеры wg/awg → INI"]
  AM --> INI
  V -- нет --> B64{"похоже на base64?
(≥16 симв., 4 варианта кодировки)"}
  B64 -- да --> DEC["декод → UTF-8-проверка"] --> V
  B64 -- нет --> J{"первый символ { или [ ?"}
  J -- да --> F{"JSON-флейвор"}
  F -->|"массив, элементы с outbounds[].protocol"| X["Xray-массив конфигов"]
  F -->|"объект с type"| S1["sing-box outbound"]
  F -->|"массив объектов с type"| S2["sing-box массив outbound'ов"]
  F -->|"объект с outbounds/endpoints"| S3["sing-box полный конфиг"]
  F -->|"массив таких конфигов"| S4["sing-box массив конфигов"]
  F -->|"map с proxies"| CY["Clash YAML → 0 узлов + подсказка
warning: clash_yaml_unsupported"]
  F -->|"иначе"| UNK["unknown → диагностика"]
  J -- нет --> I{"[Interface] + [Peer] ?"}
  I -- да --> INI["wgconf INI → wireguard-узлы"]
  I -- нет --> U["построчный URI-list
скип пустых и комментариев # // ;"]
  U --> E{"остались строки?"}
  E -- нет --> D["пусто → диагностика
(HTML-страница / полный конфиг с inbounds /
plain-text ошибка провайдера)"]
  E -- да --> P["ParseNode / parseUri построчно
(vpn:// строкой — тоже узел, B12)"]
