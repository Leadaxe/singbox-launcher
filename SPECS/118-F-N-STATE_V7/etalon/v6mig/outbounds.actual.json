{
  "outbounds": [
    {
      "tag": "[P] NL-1 •",
      "type": "vless",
      "server": "nl.example",
      "server_port": 443,
      "uuid": "11111111-1111-4111-8111-111111111111",
      "transport": {
        "type": "ws",
        "path": "/ws",
        "headers": {
          "Host": "nl.example"
        }
      },
      "tls": {
        "enabled": true,
        "server_name": "nl.example",
        "utls": {
          "enabled": true,
