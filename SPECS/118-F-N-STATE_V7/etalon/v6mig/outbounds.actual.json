      "password": "password"
    },
    {
      "tag": "Tokyo",
      "type": "vless",
      "server": "h.example",
      "server_port": 443,
      "uuid": "33333333-3333-4333-8333-333333333333",
      "tls": {
        "enabled": true,
        "server_name": "h.example",
        "utls": {
          "enabled": true,
          "fingerprint": "random"
        }
      },
      "detour": "[P] NL-1 •"
    },
    {
      "tag": "chain-1",
      "type": "chain",
      "idle_timeout": "2m",
      "outbounds": [
        "Tokyo",
        "[P] NL-1 •"
      ]
    },
    {
      "tag": "[P]select-auto",
